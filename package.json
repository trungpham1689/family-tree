{
  "name": "family-tree",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^24.19.2",
    "read-excel-file": "9.3.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "write-excel-file": "4.1.1"
  }
}
